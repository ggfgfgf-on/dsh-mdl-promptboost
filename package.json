{
  "name": "@deepseek-ai/dsh-mdl-promptboost",
  "version": "0.3.2",
  "description": "执行强度提示：一段工程化过的 system prompt（真跑验证 / 不编造已验证 / 结论优先不堆篇幅），插件页可开关与改文本",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "external": [
        "react"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt",
    "system-prompt",
    "prompt-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggfgfgf-on/dsh-mdl-promptboost.git"
  },
  "homepage": "https://github.com/ggfgfgf-on/dsh-mdl-promptboost#readme",
  "bugs": {
    "url": "https://github.com/ggfgfgf-on/dsh-mdl-promptboost/issues"
  },
  "author": "ggfgfgf-on",
  "license": "MIT"
}
